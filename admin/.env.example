# Supabase -- Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_, never import outside lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# AWS -- S3 + CloudFront
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=bibliq-content
CLOUDFRONT_DISTRIBUTION_ID=

# Public CDN base the app downloads packs/images from (CloudFront domain or a custom domain in front of it)
NEXT_PUBLIC_CDN_BASE_URL=https://cdn.bibliq.com
